{
  "name": "parenthesis-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Playwright release gate: end-to-end tests for every released milestone (docs/runbooks/playwright-release-gate.md).",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "browser:install": "playwright install --with-deps --only-shell chromium webkit",
    "browser:deps": "playwright install-deps chromium webkit",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "trace": "playwright show-trace"
  },
  "devDependencies": {
    "@guidepup/guidepup": "^0.38.0",
    "@guidepup/playwright": "^0.21.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "axe-core": "4.14.0",
    "typescript": "6.0.2"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
