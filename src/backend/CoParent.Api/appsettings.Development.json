{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "App": {
    "PublicBaseUrl": "http://localhost:4200"
  },
  "Email": {
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "UseStartTls": false
    }
  }
}
